# TidyFigure: send every request that isn't a real file to index.php
Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Force HTTPS. Remove these two lines if the domain has no SSL certificate yet.
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
  # One address for the whole site: www.example.com → example.com (better for SEO).
  # To keep www as the main address instead, delete these two lines.
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
  # Never serve hidden files (.git, .env) or internal folders. .well-known stays open for SSL checks.
  RewriteRule (^|/)\.(?!well-known/) - [F,L]
  RewriteRule ^(app|tools|storage)(/|$) - [F,L]
  RewriteRule ^(config\.php|config\.sample\.php|README\.md)$ - [F,L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.php [L,QSA]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json application/manifest+json image/svg+xml text/xml application/xml text/plain
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  # CSS and JS links carry ?v=<file time>, so a changed file gets a new address: safe to keep for a year.
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/wasm "access plus 30 days"
  ExpiresByType application/octet-stream "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType font/ttf "access plus 1 year"
  ExpiresByType image/x-icon "access plus 7 days"
  ExpiresByType image/vnd.microsoft.icon "access plus 7 days"
</IfModule>
